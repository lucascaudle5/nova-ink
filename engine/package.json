{
  "name": "nova-ink-engine",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "NOVA-owned handwriting engine spike: document model, stroke geometry, Canvas 2D renderer, pointer input, browser harness",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "bench": "node --expose-gc --import tsx scripts/bench.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
