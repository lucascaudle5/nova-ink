{
  "name": "nova-ink-chatgpt-mcp",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "NOVA Ink private persisted canvases, autosave and viewport-first tutoring",
  "scripts": {
    "dev": "concurrently -k \"vite build --watch\" \"tsx watch main.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx main.ts",
    "test": "node --import tsx --test --test-force-exit tests/*.test.mjs",
    "test:watch": "node --import tsx --test --watch tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build:host-test": "node scripts/build-host-test.mjs",
    "backup": "node scripts/backup-data.mjs",
    "restore": "node scripts/restore-data.mjs",
    "dev:engine-app": "vite -c engine-app/vite.config.ts",
    "build:engine-app": "tsc -p engine-app && vite build -c engine-app/vite.config.ts",
    "test:engine-app": "node --import tsx --test --test-force-exit engine-app/test/*.test.ts",
    "test:browser": "node engine-app/browser-test/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tldraw": "^5.5.2",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
