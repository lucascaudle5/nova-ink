{
  // NOVA Ink engine notebook. Deploy only with the user's go-ahead: `npx wrangler deploy -c wrangler.engine.jsonc`.
  "name": "nova-ink-engine",
  "main": "src/engine/index.ts",
  "compatibility_date": "2026-08-15",
  // global_fetch_strictly_public: required by the OAuth provider for Client ID Metadata Document clients (ChatGPT).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [
    { "name": "PAGE", "class_name": "PageDO" },
    { "name": "ENGINE_LIBRARY", "class_name": "NotebookLibraryDO" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PageDO", "NotebookLibraryDO"] }
  ],
  // OAUTH_KV: namespace "OAUTH_KV_ENGINE", created Oct 29, 2026 (an id is not a secret).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "50f199597cee47f181c7dcd2eed908d5" }],
  // Workers AI: nova_look transcribes the student's picture for Claude's voice mode (user decision, Oct 30, 2026).
  "ai": { "binding": "AI", "remote": true },
  // Not a secret. The Worker fails closed while this or any secret is missing.
  "vars": { "PUBLIC_ORIGIN": "https://nova-ink-engine.ai-nova-personal.workers.dev" }
}
